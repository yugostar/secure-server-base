[
    uuid(9c9b9c43-baa2-4ab2-95a7-29ab067f6f52),
    version(1.0)
]
interface SakuraShieldRpc
{
    void SakuraShieldStopService([in] handle_t binding);

    long SakuraShieldGetState(
        [in] handle_t binding,
        [out] long* authenticated,
        [out, string] wchar_t** username,
        [out] long* antivirusEnabled,
        [out] long* hasLicense,
        [out] long* licenseValid,
        [out, string] wchar_t** licenseExpiresAt,
        [out, string] wchar_t** message
    );

    long SakuraShieldLogin(
        [in] handle_t binding,
        [in, string] wchar_t* username,
        [in, string] wchar_t* password,
        [out, string] wchar_t** message
    );

    long SakuraShieldLogout([in] handle_t binding);

    long SakuraShieldActivate(
        [in] handle_t binding,
        [in, string] wchar_t* activationCode,
        [out, string] wchar_t** message
    );

    long SakuraShieldGetAvDatabaseInfo(
        [in] handle_t binding,
        [out, string] wchar_t** releaseDate,
        [out] long* recordCount,
        [out, string] wchar_t** message
    );

    long SakuraShieldScanFile(
        [in] handle_t binding,
        [in, string] wchar_t* path,
        [out] long* malicious,
        [out, string] wchar_t** report
    );

    long SakuraShieldScanDirectory(
        [in] handle_t binding,
        [in, string] wchar_t* path,
        [out] long* scannedCount,
        [out] long* detectedCount,
        [out, string] wchar_t** report
    );
}
