@baseUrl = https://localhost:8443

### 1. Регистрация обычного пользователя
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "username": "user1",
  "password": "User12345!"
}

### 2. Логин администратора
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "Admin123!"
}

### 3. Логин обычного пользователя
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "user1",
  "password": "User12345!"
}

### 4. Проверка каталога продуктов (ADMIN)
GET {{baseUrl}}/api/admin/catalog/products
Authorization: Bearer {{adminAccessToken}}

### 5. Проверка каталога типов лицензий (ADMIN)
GET {{baseUrl}}/api/admin/catalog/license-types
Authorization: Bearer {{adminAccessToken}}

### 6. Создание лицензии (ADMIN)
POST {{baseUrl}}/api/licenses
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "typeId": "{{typeId}}",
  "ownerId": "{{ownerId}}",
  "deviceCount": 2,
  "blocked": false,
  "description": "Лицензия для лабораторной №2"
}

### 7. Активация лицензии (USER)
POST {{baseUrl}}/api/licenses/activate
Authorization: Bearer {{userAccessToken}}
Content-Type: application/json

{
  "activationKey": "{{licenseCode}}",
  "deviceMac": "AA-BB-CC-DD-EE-01",
  "deviceName": "Laptop"
}

### 8. Проверка лицензии (USER)
POST {{baseUrl}}/api/licenses/check
Authorization: Bearer {{userAccessToken}}
Content-Type: application/json

{
  "deviceMac": "AA-BB-CC-DD-EE-01",
  "productId": "{{productId}}"
}

### 9. Продление лицензии (USER)
POST {{baseUrl}}/api/licenses/renew
Authorization: Bearer {{userAccessToken}}
Content-Type: application/json

{
  "activationKey": "{{licenseCode}}"
}
